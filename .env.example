# ---------------------------------------------------------------------------
# WeDrive environment configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# In production / Docker, prefer setting these as real environment variables.
# ---------------------------------------------------------------------------

# Database (consolidated on a single schema name — see database/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wedrive
DB_CHARSET=utf8mb4
DB_USER=wedrive
DB_PASSWORD=change-me

# SMTP / mail (PHPMailer) — used for reservation + reclamation notifications
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=you@example.com
# App password / SMTP secret. Legacy code reads $_ENV['ali_app_password'].
ali_app_password=

# AI ride-matching (OpenRouteService free tier). Leave blank to use the
# offline haversine fallback — the matching/CO2 feature degrades gracefully.
# Get a free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ---------------------------------------------------------------------------
# Observability (all optional — blank/absent = disabled, app runs unchanged)
# ---------------------------------------------------------------------------
# Deployment environment tag attached to logs + Sentry events.
APP_ENV=production
# Structured JSON log level: debug|info|notice|warning|error|critical
LOG_LEVEL=info
# Sentry error tracking. Blank = disabled. https://sentry.io/
SENTRY_DSN=
# Fraction of requests traced (0.0–1.0). Keep low in production.
SENTRY_TRACES_SAMPLE_RATE=0.0
